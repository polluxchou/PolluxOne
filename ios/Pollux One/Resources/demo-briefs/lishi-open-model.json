        {
          "start": 8,
          "length": 4,
          "claimId": "c2"
        }
      ]
    },
    {
      "id": "s4",
      "text": "720亿参数意味着推理部署时必须提前规划显存容量量化策略以及推理框架适配。",
      "kind": "fact",
      "claimIds": [
        "c2"
      ],
      "anchors": [
        {
          "start": 0,
          "length": 4,
          "claimId": "c2"
        }
      ]
    },
    {
      "id": "s5",
